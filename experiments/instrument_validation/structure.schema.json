{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Structural projection of completed SmolVLA ledger v2",
  "description": "Types and required fields only; does not reconcile counts, hashes, identity, outcome consistency, or event order.",
  "type": "object",
  "required": ["overall", "per_task", "robopad_ledger"],
  "properties": {
    "overall": {"$ref": "#/$defs/outcomes"},
    "per_group": {"type": "object", "additionalProperties": {"$ref": "#/$defs/groupOutcomes"}},
    "per_task": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["task_group", "task_id", "metrics"],
        "properties": {
          "task_group": {"type": "string", "minLength": 1},
          "task_id": {"type": "integer", "minimum": 0},
          "metrics": {
            "type": "object", "required": ["successes"],
            "properties": {"successes": {"type": "array", "minItems": 1, "items": {"type": "boolean"}}}
          }
        }
      }
    },
    "robopad_ledger": {
      "type": "object",
      "required": ["schema_version", "suite", "h", "denoising_steps", "warmup_passes", "episodes", "inferences", "chunk_calls", "sampler_calls"],
      "properties": {
        "schema_version": {"const": 2},
        "suite": {"type": "string", "minLength": 1},
        "h": {"type": "integer", "minimum": 1},
        "denoising_steps": {"type": "integer", "minimum": 1},
        "warmup_passes": {"type": "integer", "minimum": 1},
        "chunk_calls": {"$ref": "#/$defs/counters"},
        "sampler_calls": {"$ref": "#/$defs/counters"},
        "episodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/episode"}},
        "inferences": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/inference"}}
      }
    }
  },
  "$defs": {
    "groupOutcomes": {
      "type": "object", "required": ["n_episodes", "pc_success"],
      "properties": {
        "n_episodes": {"type": "integer", "minimum": 1},
        "pc_success": {"type": "number", "minimum": 0, "maximum": 100}
      }
    },
    "outcomes": {
      "allOf": [{"$ref": "#/$defs/groupOutcomes"}],
      "type": "object", "required": ["eval_s"],
      "properties": {"eval_s": {"type": "number", "minimum": 0}}
    },
    "identity": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "prefixItems": [
        {"type": "string", "minLength": 1},
        {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 0}
      ]
    },
    "numericValues": {
      "anyOf": [
        {"type": "number"},
        {"type": "array", "items": {"$ref": "#/$defs/numericValues"}}
      ]
    },
    "arrayRecord": {
      "type": "object", "required": ["dtype", "shape", "values", "sha256"],
      "properties": {
        "dtype": {"type": "string", "minLength": 1},
        "shape": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "values": {"type": "array", "items": {"$ref": "#/$defs/numericValues"}},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "step": {
      "type": "object", "required": ["step", "action"],
      "properties": {"step": {"type": "integer", "minimum": 0}, "action": {"$ref": "#/$defs/arrayRecord"}}
    },
    "episode": {
      "type": "object", "required": ["identity", "seeds", "initial_state", "select_calls", "producer_steps", "environment_steps"],
      "properties": {
        "identity": {"$ref": "#/$defs/identity"},
        "seeds": {
          "type": "object", "required": ["python", "numpy", "torch", "libero"],
          "additionalProperties": false,
          "properties": {
            "python": {"type": "integer", "minimum": 0},
            "numpy": {"type": "integer", "minimum": 0},
            "torch": {"type": "integer", "minimum": 0},
            "libero": {"type": "integer", "minimum": 0}
          }
        },
        "initial_state": {"$ref": "#/$defs/arrayRecord"},
        "select_calls": {"type": "integer", "minimum": 1},
        "producer_steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}},
        "environment_steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}}
      }
    },
    "inference": {
      "type": "object", "required": ["phase", "episode", "step", "cuda_ms"],
      "properties": {
        "phase": {"enum": ["warmup", "measured"]},
        "episode": {"$ref": "#/$defs/identity"},
        "step": {"type": "integer", "minimum": 0},
        "cuda_ms": {"type": "number", "minimum": 0}
      }
    },
    "counters": {
      "type": "object", "required": ["warmup", "measured"],
      "properties": {
        "warmup": {"type": "integer", "minimum": 0},
        "measured": {"type": "integer", "minimum": 0}
      }
    }
  }
}
